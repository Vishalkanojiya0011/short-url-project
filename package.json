{
  "name": "url-shortener-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A URL shortener API with click analytics and owner-only link deletion.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:tunnel": "node src/tunnel.js",
    "test": "node --test",
    "start:db": "docker compose up -d mongodb",
    "stop:db": "docker compose stop mongodb"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.12.1",
    "nanoid": "^5.1.5"
  }
}
